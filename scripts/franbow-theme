#!/usr/bin/env bash
# Fran Bow / Burtonesque — применение и откат темы.
#   franbow-theme            — применить (со статичными обоями)
#   franbow-theme --live     — применить с живыми обоями (видео)
#   franbow-theme --revert   — вернуть как было
#   franbow-theme --status   — показать, что сейчас включено
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/franbow-theme"
STATE="$STATE_DIR/previous.env"

COLOR_SCHEME="FranBow"
ICON_THEME="Papirus-Dark"
CURSOR_THEME="Bibata-Modern-Amber"
SOUND_THEME="FranBow"
WALLPAPER="$HOME/Pictures/franbow-wallpaper.png"
LIVE_WALLPAPER="$HOME/Pictures/franbow-live.mp4"
WP_PLUGIN="luisbocanegra.smart.video.wallpaper.reborn"
DEFAULT_WALLPAPER="/usr/share/wallpapers/DebianTheme/contents/images/1920x1080.svg"

FONT_FAMILY="Cormorant Garamond"
UI_SIZE=12
TITLE_SIZE=13

FONT_KEYS="font fontMenu fontToolBar fontActiveWindow fontInactiveWindow fontFixed"

notify() {
    command -v notify-send >/dev/null 2>&1 && notify-send -a "Fran Bow" "$1" "${2:-}" || true
}

say() { printf '%s\n' "$*"; }

reload_ui() {
    kbuildsycoca6 >/dev/null 2>&1 || true
    dbus-send --session --type=signal /KDE org.kde.KGlobalSettings.notifyChange int32:0 int32:0 >/dev/null 2>&1 || true
    qdbus6 org.kde.KWin /KWin reconfigure >/dev/null 2>&1 || true
}

save_state() {
    mkdir -p "$STATE_DIR"
    {
        printf 'PREV_COLOR_SCHEME=%s\n' "$(kreadconfig6 --file kdeglobals --group General --key ColorScheme)"
        printf 'PREV_ICON_THEME=%s\n' "$(kreadconfig6 --file kdeglobals --group Icons --key Theme)"
        printf 'PREV_CURSOR_THEME=%s\n' "$(kreadconfig6 --file kcminputrc --group Mouse --key cursorTheme)"
        printf 'PREV_SOUND_THEME=%s\n' "$(kreadconfig6 --file kdeglobals --group General --key SoundThemeName)"
        for k in $FONT_KEYS; do
            printf 'PREV_%s=%s\n' "$k" "$(kreadconfig6 --file kdeglobals --group General --key "$k")"
        done
    } > "$STATE"
}

set_font() { # key size weight
    kwriteconfig6 --file kdeglobals --group General --key "$1" "$FONT_FAMILY,$2,-1,$3,50,0,0,0,0,0"
}

set_live_wallpaper() {
    local js
    js=$(cat <<EOF
var json = JSON.stringify([{filename: "file://$LIVE_WALLPAPER", enabled: true, duration: 0, customDuration: 0, playbackRate: 0.0, alternativePlaybackRate: 0.0, loop: true, dayNightPhase: 0}]);
var ds = desktops();
for (var i = 0; i < ds.length; i++) {
    var d = ds[i];
    d.wallpaperPlugin = "$WP_PLUGIN";
    d.currentConfigGroup = ["Wallpaper", "$WP_PLUGIN", "General"];
    d.writeConfig("VideoUrls", json);
    d.writeConfig("FillMode", 2);
    d.writeConfig("PauseMode", 0);
    d.writeConfig("BackgroundColor", "#0d0a12");
    d.reloadConfig();
}
EOF
)
    qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "$js" >/dev/null 2>&1 || true
}

apply_theme() {
    [[ -f "$WALLPAPER" ]] || { say "Нет файла обоев: $WALLPAPER"; exit 1; }
    [[ -f "$HOME/.local/share/color-schemes/$COLOR_SCHEME.colors" ]] || { say "Нет схемы $COLOR_SCHEME"; exit 1; }

    [[ -f "$STATE" ]] || save_state

    plasma-apply-colorscheme "$COLOR_SCHEME" >/dev/null
    if [[ "${APPLY_LIVE:-0}" == "1" && -f "$LIVE_WALLPAPER" ]]; then
        set_live_wallpaper
    else
        plasma-apply-wallpaperimage "$WALLPAPER" >/dev/null
    fi

    kwriteconfig6 --file kdeglobals --group Icons --key Theme "$ICON_THEME"
    kwriteconfig6 --file kcminputrc --group Mouse --key cursorTheme "$CURSOR_THEME"
    XCURSOR_PATH="$HOME/.local/share/icons:${XCURSOR_PATH:-}" plasma-apply-cursortheme "$CURSOR_THEME" >/dev/null 2>&1 || true
    kwriteconfig6 --file kdeglobals --group General --key SoundThemeName "$SOUND_THEME"

    # Шрифты по умолчанию не трогаем: включаются только с флагом --fonts
    if [[ "${APPLY_FONTS:-0}" == "1" ]]; then
        set_font font "$UI_SIZE" 50
        set_font fontMenu "$UI_SIZE" 50
        set_font fontToolBar "$UI_SIZE" 50
        set_font fontActiveWindow "$TITLE_SIZE" 63
        set_font fontInactiveWindow "$TITLE_SIZE" 50
    fi

    reload_ui
    local wp_kind="статичные"
    [[ "${APPLY_LIVE:-0}" == "1" && -f "$LIVE_WALLPAPER" ]] && wp_kind="живые (видео)"
    notify "Тема Fran Bow применена" "Иконки, курсоры, звуки, обои ($wp_kind) включены."
    say "Готово: $COLOR_SCHEME / $ICON_THEME / $CURSOR_THEME / звуки $SOUND_THEME / обои $wp_kind"
}

revert_theme() {
    local prev_scheme="BreezeLight"
    local prev_icons="breeze"
    local prev_cursor="breeze_cursors"
    local prev_sound="freedesktop"

    if [[ -f "$STATE" ]]; then
        # shellcheck disable=SC1090
        source "$STATE"
        prev_scheme="${PREV_COLOR_SCHEME:-BreezeLight}"
        prev_icons="${PREV_ICON_THEME:-breeze}"
        prev_cursor="${PREV_CURSOR_THEME:-breeze_cursors}"
        prev_sound="${PREV_SOUND_THEME:-freedesktop}"
    fi

    [[ -n "$prev_icons" ]]  || prev_icons="breeze"
    [[ -n "$prev_cursor" ]] || prev_cursor="breeze_cursors"
    [[ -n "$prev_sound" ]]  || prev_sound="freedesktop"

    plasma-apply-colorscheme "$prev_scheme" >/dev/null 2>&1 || plasma-apply-colorscheme BreezeLight >/dev/null 2>&1 || true
    plasma-apply-wallpaperimage "$DEFAULT_WALLPAPER" >/dev/null 2>&1 || true

    kwriteconfig6 --file kdeglobals --group Icons --key Theme "$prev_icons"
    kwriteconfig6 --file kcminputrc --group Mouse --key cursorTheme "$prev_cursor"
    plasma-apply-cursortheme "$prev_cursor" >/dev/null 2>&1 || true
    kwriteconfig6 --file kdeglobals --group General --key SoundThemeName "$prev_sound"

    for k in $FONT_KEYS; do
        local var="PREV_$k"
        local val="${!var:-}"
        if [[ -n "$val" ]]; then
            kwriteconfig6 --file kdeglobals --group General --key "$k" "$val"
        else
            kwriteconfig6 --file kdeglobals --group General --key "$k" --delete 2>/dev/null || true
        fi
    done

    reload_ui
    notify "Тема Fran Bow отключена" "Схема: $prev_scheme"
    say "Откатил: $prev_scheme / $prev_icons / $prev_cursor / звуки $prev_sound"
    say "Экран входа (SDDM) не менялся: /etc/sddm.conf.d/franbow.conf"
}

status_theme() {
    say "Схема:   $(kreadconfig6 --file kdeglobals --group General --key ColorScheme)"
    say "Иконки:  $(kreadconfig6 --file kdeglobals --group Icons --key Theme)"
    say "Курсор:  $(kreadconfig6 --file kcminputrc --group Mouse --key cursorTheme)"
    say "Звуки:   $(kreadconfig6 --file kdeglobals --group General --key SoundThemeName)"
    say "Шрифт:   $(kreadconfig6 --file kdeglobals --group General --key font)"
    say "Обои:    $(qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript 'print(desktops()[0].wallpaperPlugin)' 2>/dev/null || echo '?')"
    [[ -f "$STATE" ]] && say "Состояние для отката: $STATE"
}

case "${1:-}" in
    ""|--apply) apply_theme ;;
    --live)     APPLY_LIVE=1; apply_theme ;;
    --fonts)    APPLY_FONTS=1; apply_theme ;;
    --revert)   revert_theme ;;
    --status)   status_theme ;;
    -h|--help)  say "Использование: $(basename "$0") [--apply|--live|--fonts|--revert|--status]" ;;
    *)          say "Неизвестный аргумент: $1"; exit 2 ;;
esac
